rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile photos
    match /users/{userId}/profile/{allPaths=**} {
      // Anyone can read profile photos (for public profiles)
      allow read: if true;
      
      // Allow writes for authenticated users OR server-side uploads
      // Server uploads won't have request.auth, so we allow all writes with proper validation
      allow write: if request.resource.size < 2 * 1024 * 1024  // Max 2MB
                   && request.resource.contentType.matches('image/.*');  // Images only
      
      // Only the owner can delete their profile photos
      allow delete: if request.auth != null 
                    && request.auth.uid == userId;
    }
  
    // Property listing photos
    match /listings/{userId}/{allPaths=**} {
      // Anyone can read listing photos (for public browsing)
      allow read: if true;
      
      // Allow writes with size and type validation
      // Server-side uploads won't have request.auth
      allow write: if request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');  // Images only
      
      // Only the owner can delete their listing photos
      allow delete: if request.auth != null 
                    && request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
